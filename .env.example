# Copy to .env for local overrides. NEVER commit .env and NEVER put credentials in this file.
# Accounts and passwords are added from the extension UI and stored in the OS credential store.

# --- Service ----------------------------------------------------------------
# Local API port. The extension defaults to 47400 (change it in Settings → Service connection).
PORT=47400
# SQLite database, browser profiles and the encrypted fallback vault (relative to the project root)
DATA_DIR=data
# Run logs and screenshots
LOGS_DIR=logs
# debug | info
LOG_LEVEL=info
SCHEDULER_TICK_MS=15000

# --- Security ---------------------------------------------------------------
# Optional: pin the Chrome extension ID that may pair. Empty = the first extension that pairs is trusted.
TASKPILOT_EXTENSION_ID=

# --- Credential storage -----------------------------------------------------
# keyring (default: OS credential manager) | vault (AES-256-GCM encrypted file in DATA_DIR/secrets)
CREDENTIAL_BACKEND=
# Optional 32-byte base64 key for the vault. If empty, DATA_DIR/secrets/master.key is generated.
CREDENTIAL_KEY=

# --- Platform overrides (testing against mock sites only) ---------------------
NAUKRI_BASE_URL=https://www.naukri.com
